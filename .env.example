# Dockyard configuration. Copy to .env and fill in.
# ---------------------------------------------------------------

# --- API server ---
# The panel always listens on 8000. The only deployment that differs is one
# behind a tunnel, which publishes it on port 80 instead (see PANEL_PORT below).
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
# Public base URL of the panel, used for links shown in the UI.
PUBLIC_URL=http://localhost:8000

# --- Postgres ---
DATABASE_URL=postgres://dockyard:CHANGE_ME@127.0.0.1:5432/dockyard
PGSSLMODE=disable

# --- Docker engine ---
# Leave empty to use the default socket (/var/run/docker.sock, or npipe on Windows).
# tcp://127.0.0.1:2375 for a plain TCP daemon.
DOCKER_HOST=
# Optional TLS for tcp daemons:
# DOCKER_TLS_CERT=/certs/cert.pem
# DOCKER_TLS_KEY=/certs/key.pem
# DOCKER_TLS_CA=/certs/ca.pem

# --- Cloudflare tunnels ---
# Path to the cloudflared binary. Override in tests with a stub.
CLOUDFLARED_BIN=cloudflared
# Directory where named-tunnel credentials.json / config.yml are written.
TUNNEL_DATA_DIR=./data/tunnels
# Host used when a tunnel targets a container's published port. Use
# host.docker.internal when the panel itself runs in a container.
TUNNEL_TARGET_HOST=127.0.0.1
# Cloudflare API token (Zone:DNS:Edit + Account:Cloudflare Tunnel:Edit).
# Can also be set at runtime from Settings in the UI (stored encrypted in the DB).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Templates ---
# Directory scanned for *.json template files. A template dropped in here appears
# in the panel on the next page load, with no rebuild and no restart.
# docker-compose.yml bind-mounts ./data/templates to it. See
# deploy/template-examples/ for files to copy in.
DOCKYARD_TEMPLATE_DIR=./data/templates

# --- Template repository ---
# A public repository of template files, pulled over the network and reconciled like local files, so
# a template can be added or corrected centrally instead of on every install. The panel reads
# `templates/*.json` (or `*.json` at the root if there is no such folder) and caches it in
# DOCKYARD_TEMPLATES_DIR. Precedence, highest first: a template you edited in the panel, a local
# file, then this repository. Pulling can therefore never undo local work.
# Set DOCKYARD_TEMPLATES_REPO= (empty) to switch the whole source off.
DOCKYARD_TEMPLATES_REPO=dockyardapp/dockyard-templates
DOCKYARD_TEMPLATES_BRANCH=main
# Cache directory. Must be writable; a container path in Docker deployments.
DOCKYARD_TEMPLATES_DIR=./data/templates-remote
# How long a successful pull is trusted before the next page load refreshes it, in minutes.
DOCKYARD_TEMPLATES_REFRESH_MINUTES=15
# Optional. Only needed to raise the anonymous GitHub API limit (60 requests an hour per address) or
# to pull from a private repository. A read-only, public-repo-scope token is enough. Never logged.
DOCKYARD_TEMPLATES_TOKEN=

# --- Secrets ---
# 32+ byte hex/base64 key used to encrypt secrets at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# --- Docker Compose only ---
# Host docker group id. The panel image runs as uid/gid 1001 and the socket is
# root:docker 0660, so the panel needs this to open /var/run/docker.sock.
# Find it with: getent group docker | cut -d: -f3
DOCKER_GID=
# Port the panel is published on. The panel itself always listens on 8000; this
# is the host-side port that maps to it. Leave it alone unless a tunnel is in
# front, which is the one case that wants 80.
PANEL_PORT=8000
# Address the panel is published on. 0.0.0.0 is the default and reachable from
# anywhere the host is; 127.0.0.1 keeps it on the host, which is what you want
# when a tunnel or a reverse proxy is the only intended way in. The panel mounts
# the Docker socket, so this address is a root-equivalent door.
PANEL_BIND=0.0.0.0

# --- Reverse proxy ---
# An optional nginx service that terminates TLS in front of the panel, off by default. Compose reads
# COMPOSE_PROFILES from this file itself, so setting it here turns the proxy on for every
# `docker compose up -d`, including the ones install.sh and deploy/update.sh run, without either
# script knowing the proxy exists. Set it to "proxy" to enable the service; leave it empty for none.
#
# Security note: the panel mounts the Docker socket, so its published port is a root-equivalent
# door. The proxy is meant to be the only public one. When this is on, set PANEL_BIND=127.0.0.1 so
# the panel itself is reachable only from the host, and let nginx be the single address the outside
# world can reach. install.sh renders deploy/nginx/dockyard-http.conf.template or
# dockyard-tls.conf.template into data/nginx/dockyard.conf and, when there is no real certificate,
# generates a self-signed one with deploy/nginx/gen-cert.sh.
COMPOSE_PROFILES=
# Address nginx publishes on. 0.0.0.0 is reachable from anywhere the host is; 127.0.0.1 keeps the
# proxy on the host, which is what a load balancer that talks to it locally wants.
PROXY_BIND=0.0.0.0
# Host ports the proxy is published on. Inside the container nginx always listens on 80 and 443.
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# --- Sessions ---
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
# Login attempts per IP per minute. Raise it for a test host that signs in many
# accounts; leave it low in production.
DOCKYARD_LOGIN_RATE_MAX=10

# --- Version and updates ---
# The panel shows the build it is running and can pull a newer one. It reads the
# repository over the GitHub API, which works unauthenticated while the repo is
# public; add a read-only token to keep it working while the repo is private.
DOCKYARD_UPDATE_REPO=dockyardapp/dockyard
DOCKYARD_UPDATE_BRANCH=main
# Optional. A fine-grained token with read-only Contents access is enough. The
# panel only ever reads; the host updater in deploy/update.sh does the pulling.
DOCKYARD_UPDATE_TOKEN=
# The panel cannot rebuild its own container, so it writes a request into this
# directory and a systemd path unit on the host runs deploy/update.sh. Install it
# with deploy/install-updater.sh. Set to false to hide the button entirely.
DOCKYARD_UPDATE_ENABLED=true
# Where the panel and the host updater meet. Defaults to <repo>/data/update, which
# docker-compose.yml bind-mounts into the panel.
DOCKYARD_UPDATE_SPOOL=
