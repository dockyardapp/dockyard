# Dockyard behind nginx: TLS terminated here.
#
# install.sh renders this to <repo>/data/nginx/dockyard.conf and bind-mounts it read-only to
# /etc/nginx/conf.d/default.conf. It substitutes four placeholders with sed:
#   @@SERVER_NAME@@   the domain, the host IP, or _ to match any name
#   @@UPSTREAM@@      the panel address: panel:8000 inside compose, 127.0.0.1:8000 for host nginx
#   @@CERT_FILE@@     certificate path relative to /etc/nginx/certs, e.g. <name>/fullchain.pem
#   @@KEY_FILE@@      private key path relative to /etc/nginx/certs, e.g. <name>/privkey.pem
#
# deploy/nginx/gen-cert.sh writes a self-signed pair into <name>/fullchain.pem and
# <name>/privkey.pem under that certs directory, so @@CERT_FILE@@ and @@KEY_FILE@@ can be
# "<name>/fullchain.pem" and "<name>/privkey.pem". A Let's Encrypt certificate works the same way
# once its fullchain and privkey are placed at the same relative paths.
#
# The WebSocket endpoints (/ws/containers/:id/logs, /ws/containers/:id/stats, /ws/events) carry live
# log and stats traffic, so the Upgrade/Connection headers and a long read timeout are required or
# the log view drops every 60s.
#
# Do not expose this without TLS: mounting the Docker socket gives the panel root-equivalent control
# of the host.

# ---------------------------------------------------------------------------
# HTTP: everything redirects to HTTPS, except the ACME challenge that certbot
# needs to renew the certificate. Redirecting that too would break renewal.
# ---------------------------------------------------------------------------

server {
    listen 80;
    listen [::]:80;
    server_name @@SERVER_NAME@@;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# HTTPS: the real thing.
# ---------------------------------------------------------------------------

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name @@SERVER_NAME@@;

    ssl_certificate     /etc/nginx/certs/@@CERT_FILE@@;
    ssl_certificate_key /etc/nginx/certs/@@KEY_FILE@@;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Only meaningful once the certificate chain is complete and the host is publicly reachable.
    # Harmless if the resolver cannot be reached; the response is served without the staple.
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    # HSTS is off on purpose. It makes browsers refuse the plain-HTTP fallback, so a certificate
    # that breaks (expired, wrong name, a self-signed one replaced by a re-render) becomes
    # unrecoverable without clearing browser state. Enable it only after confirming HTTPS works end
    # to end, and start with a short max-age if unsure:
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # The app sets these on its own responses too; repeating them here covers anything nginx
    # generates itself (error pages, redirects).
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Panel sessions are cookies, not headers, so no CORS dance is needed.
    client_max_body_size 4m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Long-lived WebSocket upgrades need HTTP/1.1 and the hop-by-hop headers set.
    location /ws/ {
        proxy_pass http://@@UPSTREAM@@;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Log and stats streams are idle between frames; do not cut them at 60s.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # Image pulls stream progress and can take minutes.
    location /api/images/pull {
        proxy_pass http://@@UPSTREAM@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://@@UPSTREAM@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }
}
