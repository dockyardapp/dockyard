# Dockyard behind nginx.
#
# Drop into /etc/nginx/conf.d/dockyard.conf (or a sites-available entry), set
# server_name and the certificate paths, then:
#   nginx -t && systemctl reload nginx
#
# This file terminates TLS itself, which is the topology the app assumes in
# production: with NODE_ENV=production the server refuses to boot unless
# COOKIE_SECURE=true, so the session cookie cannot go out in the clear by
# accident. If TLS terminates somewhere else, use the variant at the bottom.
#
# The WebSocket endpoints (/ws/containers/:id/logs, /ws/containers/:id/stats,
# /ws/events) carry live log and stats traffic, so the Upgrade/Connection headers
# and a long read timeout are required or the log view will drop every 60s.
#
# Do not expose this without TLS: mounting the Docker socket gives the panel
# root-equivalent control of the host.

upstream dockyard_panel {
    server 127.0.0.1:8000;
    keepalive 16;
}

# ---------------------------------------------------------------------------
# HTTP: everything redirects to HTTPS, except the ACME challenge that certbot
# needs to renew the certificate. Redirecting that too would break renewal.
# ---------------------------------------------------------------------------

server {
    listen 80;
    listen [::]:80;
    server_name dockyard.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# HTTPS: the real thing.
# ---------------------------------------------------------------------------

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name dockyard.example.com;

    # certbot writes these. For a self-managed certificate, point them at your
    # own fullchain and key instead.
    ssl_certificate     /etc/letsencrypt/live/dockyard.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dockyard.example.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Only meaningful once the certificate chain is complete and the host is
    # publicly reachable. Harmless if the resolver cannot be reached; the
    # response is served without the staple.
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    # Enable only after confirming HTTPS works: HSTS makes browsers refuse the
    # plain-HTTP fallback, so a broken certificate becomes unrecoverable without
    # clearing browser state. Start with a short max-age if unsure.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # The app sets these on its own responses too; repeating them here covers
    # anything nginx generates itself (error pages, redirects).
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Panel sessions are cookies, not headers, so no CORS dance is needed.
    client_max_body_size 4m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Long-lived WebSocket upgrades need HTTP/1.1 and the hop-by-hop headers set.
    location /ws/ {
        proxy_pass http://dockyard_panel;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Log and stats streams are idle between frames; do not cut them at 60s.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # Image pulls stream progress and can take minutes.
    location /api/images/pull {
        proxy_pass http://dockyard_panel;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://dockyard_panel;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }
}

# ---------------------------------------------------------------------------
# Variant: TLS terminates somewhere else (load balancer, Cloudflare, another
# proxy). Then this box only serves plain HTTP on a private interface, and the
# app still needs COOKIE_SECURE=true in production, because the browser is the
# one that decides whether to send the cookie and it only ever sees HTTPS.
#
# The location blocks are identical to the HTTPS server above; drop the TLS
# directives, the HSTS header and the redirect, and listen on the loopback or a
# private address only:
#
# server {
#     listen 127.0.0.1:8090;
#     server_name dockyard.example.com;
#     # ... the same add_header, gzip and location blocks ...
# }
#
# In that topology the upstream must forward X-Forwarded-Proto: https, or the
# app cannot tell it is behind TLS.
# ---------------------------------------------------------------------------
